{
  "name": "vibe-fun",
  "version": "0.1.0",
  "private": true,
  "description": "An MCP Apps server that distributes self-contained HTML mini-games (2048, Sudoku, Minesweeper, Pacman) to any MCP host.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "stdio": "tsx bin/stdio.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "check:game-dates": "tsx scripts/check-game-updated-at.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@vercel/analytics": "^2.0.1",
    "mcp-handler": "^2.1.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0"
  }
}
